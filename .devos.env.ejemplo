# Copia a .devos.env (gitignored) y ajusta. Los agentes no pueden leerlo para cambiarlo ni editarlo.
DEVOS_DUENO=tu-usuario-github        # menciones en el Issue y único que aprueba por etiqueta
DEVOS_BASE=main
# Modelos por fase (alias de Claude Code u id completo, p. ej. claude-fable-5-1 para tareas muy difíciles)
DEVOS_MODELO_PLAN=opus
DEVOS_MODELO_BUILD=sonnet
DEVOS_MODELO_VERIF=opus
DEVOS_MODELO_RETRO=sonnet
DEVOS_MAX_INTENTOS=3                  # por tarea: construir → checks → verificador
DEVOS_MAX_TURNOS=80                   # por sesión headless (tope de costo)
DEVOS_AUTOMERGE=1                     # 0 = siempre esperas tú para fusionar
DEVOS_MERGE_SIN_CI=0                  # 1 = fusiona aunque el repo no tenga checks obligatorios (no recomendado)
# Comandos del proyecto para el hook Stop (si no son npm test / npm run lint / pytest / ruff)
# DEVOS_TEST_CMD="pytest -q"
# DEVOS_LINT_CMD="ruff check ."
# DEVOS_E2E_CMD="npx --no-install playwright test"
